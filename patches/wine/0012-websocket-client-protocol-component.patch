+            if (ws->filled < 4) goto need_more;
+            payload_len = (data[2] << 8) | data[3];
+            header_len = 4;
+        }
+        else if (payload_len == 127)
+        {
+            int i;
+            if (ws->filled < 10) goto need_more;
+            for (payload_len = 0, i = 2; i < 10; i++) payload_len = (payload_len << 8) | data[i];
