+static void drop_received( struct websocket *ws, ULONG len )
+{
+    ws->filled -= len;
+    memmove( ws->recv_area, ws->recv_area + len, ws->filled );
+}
+
+/* look at what has been received: something to indicate, or more is needed from the network */
+static HRESULT get_receive_action( struct websocket *ws, WEB_SOCKET_BUFFER *buffers, ULONG *count,
+        WEB_SOCKET_ACTION *action, WEB_SOCKET_BUFFER_TYPE *type, void **app_context, void **action_context )
+{
+    BYTE *data = ws->recv_area;
+
+    if (!ws->receive_pending) return S_OK;
+    *app_context = ws->receive_app_context;
+
+    for (;;)
+    {
+        ULONG header_len;
+        ULONGLONG payload_len;
+        BYTE op;
+        BOOL fin;
+
+        if (ws->frame_left)
+        {
+            /* in the middle of a data frame: hand out what is here */
+            if (!ws->filled) goto need_more;
+            ws->indicated = min( ws->filled, ws->frame_left );
+            ws->frame_left -= ws->indicated;
+            buffers[0].Data.pbBuffer = data;
+            buffers[0].Data.ulBufferLength = ws->indicated;
+            *type = data_type( ws->message_op, ws->frame_fin && !ws->frame_left );
+            break;
+        }
