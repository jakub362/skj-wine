+/*
+ * The component does no I/O itself. The caller asks it what to do next (WebSocketGetAction), does
+ * that on its connection and reports back (WebSocketCompleteAction):
+ *   send queue:    SEND_TO_NETWORK (frame header + masked payload), ..., INDICATE_SEND_COMPLETE
+ *   receive queue: RECEIVE_FROM_NETWORK (fill this buffer), ..., INDICATE_RECEIVE_COMPLETE (payload)
+ * Every buffer handed out lies in one memory block, which the caller may provide
+ * (WEB_SOCKET_ALLOCATED_BUFFER_PROPERTY_TYPE); .NET Framework checks that they do. Its layout:
+ *   [ receive area | send area | control area: one frame header + one pong payload ]
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "bcrypt.h"
+#include "wincrypt.h"
 #include "wine/debug.h"
 
 #include "websocket.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(websocket);
 
-HRESULT WINAPI WebSocketCreateClientHandle(const PWEB_SOCKET_PROPERTY properties, 
-    ULONG count, WEB_SOCKET_HANDLE *handle)
+#define E_INVALID_OPERATION          ((HRESULT)0x80000050)
+
+#define DEFAULT_BUFFER_SIZE   4096
+#define MIN_RECEIVE_SIZE      256
+#define MIN_SEND_SIZE         16
+#define MAX_BUFFER_SIZE       (64 * 1024)
+#define CONTROL_AREA_SIZE     144   /* what .NET reserves on top of the two areas */
+#define CONTROL_PAYLOAD       16    /* offset of the pong payload in the control area */
+#define DEFAULT_KEEPALIVE_MS  30000
+
+#define OP_CONTINUATION 0x0
+#define OP_TEXT         0x1
+#define OP_BINARY       0x2
+#define OP_CLOSE        0x8
+#define OP_PING         0x9
+#define OP_PONG         0xa
+
+/* action contexts handed to the caller */
+#define CTX_RECEIVE_FROM_NETWORK ((void *)1)
+#define CTX_INDICATE_RECEIVE     ((void *)2)
+#define CTX_SEND_TO_NETWORK      ((void *)3)
+#define CTX_INDICATE_SEND        ((void *)4)
+
+struct send_request
+{
+    BOOL active;
+    BYTE opcode;
+    BOOL fin;
+    WEB_SOCKET_BUFFER_TYPE type;
+    void *app_context;
+    const BYTE *payload;   /* the caller's payload, copied piece by piece when framed */
+    ULONG length;
+    ULONG done;            /* payload bytes handed out for sending */
+    BOOL header_sent;
+    BOOL complete;         /* everything is on the wire, INDICATE_SEND_COMPLETE next */
+    BYTE mask[4];
+    BYTE control[2 + 123]; /* close status + reason */
+};
+
+struct websocket
+{
+    CRITICAL_SECTION cs;
+    BOOL aborted;
+    BOOL masking;
+    ULONG receive_size, send_size;
+    BYTE *own_block;
+    BYTE *recv_area, *send_area, *ctrl_area;
+    char key[32];                           /* Sec-WebSocket-Key */
+    WEB_SOCKET_HTTP_HEADER headers[4];
+
+    /* receive side */
+    BOOL receive_pending;                   /* WebSocketReceive called, nothing indicated yet */
+    void *receive_app_context;
+    void *receive_outstanding;              /* action the caller hasn't completed yet */
+    ULONG filled;                           /* bytes in recv_area */
+    ULONG frame_left;                       /* payload bytes of the current data frame not yet indicated */
+    BOOL frame_fin;
+    BYTE message_op;                        /* OP_TEXT / OP_BINARY of the message in progress */
+    ULONG indicated;                        /* bytes at the start of recv_area that are indicated */
+
+    /* send side */
+    struct send_request send;               /* the caller's WebSocketSend */
+    struct send_request pong;               /* our answer to a ping, goes first */
+    struct send_request *sending;           /* request whose action is outstanding */
+    ULONG send_chunk;                       /* payload bytes in the outstanding SEND_TO_NETWORK action */
+    BOOL message_open;                      /* a fragmented message is being sent */
+    BYTE pong_payload[125];
+};
+
+static struct websocket *get_socket( WEB_SOCKET_HANDLE handle )
+{
+    return (struct websocket *)handle;
+}
+
+static void random_bytes( BYTE *buf, ULONG len )
+{
+    if (BCryptGenRandom( NULL, buf, len, BCRYPT_USE_SYSTEM_PREFERRED_RNG ))
+        while (len--) buf[len] = rand();
+}
+
+HRESULT WINAPI WebSocketCreateClientHandle( const PWEB_SOCKET_PROPERTY properties, ULONG count, WEB_SOCKET_HANDLE *handle )
+{
+    BYTE *block = NULL, key[16];
+    ULONG block_size = 0, i;
+    struct websocket *ws;
+    DWORD len;
+
+    TRACE( "%p, %lu, %p\n", properties, count, handle );
+
+    if (!handle || (count && !properties)) return E_INVALIDARG;
+    if (!(ws = calloc( 1, sizeof(*ws) ))) return E_OUTOFMEMORY;
+    ws->masking = TRUE;
+    ws->receive_size = ws->send_size = DEFAULT_BUFFER_SIZE;
+
+    for (i = 0; i < count; i++)
+    {
+        const WEB_SOCKET_PROPERTY *prop = &properties[i];
+        switch (prop->Type)
+        {
+        case WEB_SOCKET_RECEIVE_BUFFER_SIZE_PROPERTY_TYPE:
+            if (prop->ulValueSize != sizeof(ULONG)) goto invalid;
+            ws->receive_size = *(ULONG *)prop->pvValue;
+            break;
+        case WEB_SOCKET_SEND_BUFFER_SIZE_PROPERTY_TYPE:
+            if (prop->ulValueSize != sizeof(ULONG)) goto invalid;
+            ws->send_size = *(ULONG *)prop->pvValue;
+            break;
+        case WEB_SOCKET_DISABLE_MASKING_PROPERTY_TYPE:
+            if (prop->ulValueSize != sizeof(BOOL)) goto invalid;
+            ws->masking = !*(BOOL *)prop->pvValue;
+            break;
+        case WEB_SOCKET_ALLOCATED_BUFFER_PROPERTY_TYPE:
+            /* the value holds the buffer address, the size is the size of the buffer */
+            block = *(BYTE **)prop->pvValue;
+            block_size = prop->ulValueSize;
+            break;
+        case WEB_SOCKET_DISABLE_UTF8_VERIFICATION_PROPERTY_TYPE:
+        case WEB_SOCKET_KEEPALIVE_INTERVAL_PROPERTY_TYPE:
+            break;
+        default:
+            FIXME( "property %u not supported\n", prop->Type );
+            goto invalid;
+        }
+    }
+    if (ws->receive_size < MIN_RECEIVE_SIZE || ws->receive_size > MAX_BUFFER_SIZE ||
+        ws->send_size < MIN_SEND_SIZE || ws->send_size > MAX_BUFFER_SIZE) goto invalid;
+
+    if (block)
+    {
+        if (block_size < ws->receive_size + ws->send_size + CONTROL_AREA_SIZE) goto invalid;
+    }
+    else if (!(block = ws->own_block = malloc( ws->receive_size + ws->send_size + CONTROL_AREA_SIZE )))
+    {
+        free( ws );
+        return E_OUTOFMEMORY;
+    }
+    ws->recv_area = block;
+    ws->send_area = block + ws->receive_size;
+    ws->ctrl_area = ws->send_area + ws->send_size;
+
+    random_bytes( key, sizeof(key) );
+    len = sizeof(ws->key);
+    CryptBinaryToStringA( key, sizeof(key), CRYPT_STRING_BASE64 | CRYPT_STRING_NOCRLF, ws->key, &len );
+
+    InitializeCriticalSectionEx( &ws->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    ws->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": websocket.cs");
+    *handle = (WEB_SOCKET_HANDLE)ws;
+    TRACE( "-> %p, receive %lu, send %lu, masking %d\n", ws, ws->receive_size, ws->send_size, ws->masking );
+    return S_OK;
+
+invalid:
+    free( ws );
+    return E_INVALIDARG;
+}
+
+static void set_header( WEB_SOCKET_HTTP_HEADER *header, const char *name, const char *value )
+{
+    header->pcName = (char *)name;
+    header->ulNameLength = strlen( name );
+    header->pcValue = (char *)value;
+    header->ulValueLength = strlen( value );
+}
+
+HRESULT WINAPI WebSocketBeginClientHandshake( WEB_SOCKET_HANDLE handle, PCSTR *subprotocols, ULONG subprotocol_count,
+        PCSTR *extensions, ULONG extension_count, const WEB_SOCKET_HTTP_HEADER *initial_headers,
+        ULONG initial_header_count, WEB_SOCKET_HTTP_HEADER **additional_headers, ULONG *additional_header_count )
+{
+    struct websocket *ws = get_socket( handle );
+
+    TRACE( "%p, %p, %lu, %p, %lu, %p, %lu, %p, %p\n", handle, subprotocols, subprotocol_count, extensions,
+           extension_count, initial_headers, initial_header_count, additional_headers, additional_header_count );
+
+    if (!ws || !additional_headers || !additional_header_count) return E_INVALIDARG;
+    if (subprotocol_count || extension_count) FIXME( "subprotocols and extensions are not offered\n" );
+
+    set_header( &ws->headers[0], "Connection", "Upgrade" );
+    set_header( &ws->headers[1], "Upgrade", "websocket" );
+    set_header( &ws->headers[2], "Sec-WebSocket-Version", "13" );
+    set_header( &ws->headers[3], "Sec-WebSocket-Key", ws->key );
+    *additional_headers = ws->headers;
+    *additional_header_count = ARRAY_SIZE(ws->headers);
+    return S_OK;
+}
+
+static BOOL header_is( const WEB_SOCKET_HTTP_HEADER *header, const char *name )
+{
+    return header->ulNameLength == strlen( name ) && !_strnicmp( header->pcName, name, header->ulNameLength );
+}
+
+HRESULT WINAPI WebSocketEndClientHandshake( WEB_SOCKET_HANDLE handle, const WEB_SOCKET_HTTP_HEADER *response_headers,
+        ULONG response_header_count, ULONG *selected_extensions, ULONG *selected_extension_count,
+        ULONG *selected_subprotocol )
+{
+    static const char guid[] = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
+    struct websocket *ws = get_socket( handle );
+    char input[96], expected[40];
+    DWORD len = sizeof(expected);
+    BYTE hash[20];
+    ULONG i;
+
+    TRACE( "%p, %p, %lu, %p, %p, %p\n", handle, response_headers, response_header_count, selected_extensions,
+           selected_extension_count, selected_subprotocol );
+
+    if (!ws || (response_header_count && !response_headers)) return E_INVALIDARG;
+
+    strcpy( input, ws->key );
+    strcat( input, guid );
+    if (BCryptHash( BCRYPT_SHA1_ALG_HANDLE, NULL, 0, (BYTE *)input, strlen( input ), hash, sizeof(hash) ))
+        return E_FAIL;
+    CryptBinaryToStringA( hash, sizeof(hash), CRYPT_STRING_BASE64 | CRYPT_STRING_NOCRLF, expected, &len );
+
+    for (i = 0; i < response_header_count; i++)
+    {
+        if (!header_is( &response_headers[i], "Sec-WebSocket-Accept" )) continue;
+        if (response_headers[i].ulValueLength == strlen( expected ) &&
+            !memcmp( response_headers[i].pcValue, expected, response_headers[i].ulValueLength ))
+            break;
+        WARN( "wrong Sec-WebSocket-Accept %s, expected %s\n",
+              debugstr_an( response_headers[i].pcValue, response_headers[i].ulValueLength ), expected );
+        return E_INVALID_PROTOCOL_FORMAT;
+    }
+    if (i == response_header_count)
+    {
+        WARN( "no Sec-WebSocket-Accept header\n" );
+        return E_INVALID_PROTOCOL_FORMAT;
+    }
+
+    if (selected_extension_count) *selected_extension_count = 0;
+    if (selected_subprotocol) *selected_subprotocol = 0;
+    return S_OK;
+}
+
+HRESULT WINAPI WebSocketSend( WEB_SOCKET_HANDLE handle, WEB_SOCKET_BUFFER_TYPE type, WEB_SOCKET_BUFFER *buffer,
+        void *context )
+{
+    struct websocket *ws = get_socket( handle );
+    struct send_request *req;
+    HRESULT hr = S_OK;
+
+    TRACE( "%p, %#x, %p, %p\n", handle, type, buffer, context );
+
+    if (!ws) return E_INVALIDARG;
+    EnterCriticalSection( &ws->cs );
+    req = &ws->send;
+    if (ws->aborted || req->active) hr = E_INVALID_OPERATION;
+    else
+    {
+        memset( req, 0, sizeof(*req) );
+        req->type = type;
+        req->app_context = context;
+        req->fin = TRUE;
+        switch (type)
+        {
+        case WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE:
+        case WEB_SOCKET_UTF8_FRAGMENT_BUFFER_TYPE:
+        case WEB_SOCKET_BINARY_MESSAGE_BUFFER_TYPE:
+        case WEB_SOCKET_BINARY_FRAGMENT_BUFFER_TYPE:
+            req->fin = type == WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE || type == WEB_SOCKET_BINARY_MESSAGE_BUFFER_TYPE;
+            if (ws->message_open) req->opcode = OP_CONTINUATION;
+            else req->opcode = (type == WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE || type == WEB_SOCKET_UTF8_FRAGMENT_BUFFER_TYPE)
+                               ? OP_TEXT : OP_BINARY;
+            ws->message_open = !req->fin;
+            if (buffer)
+            {
+                req->payload = buffer->Data.pbBuffer;
+                req->length = buffer->Data.ulBufferLength;
+                TRACE( "sending %s\n", debugstr_an( (char *)req->payload, min( req->length, 300 ) ) );
+            }
+            break;
+        case WEB_SOCKET_CLOSE_BUFFER_TYPE:
+            req->opcode = OP_CLOSE;
+            if (buffer && buffer->CloseStatus.usStatus)
+            {
+                ULONG reason = min( buffer->CloseStatus.ulReasonLength, sizeof(req->control) - 2 );
+                req->control[0] = buffer->CloseStatus.usStatus >> 8;
+                req->control[1] = buffer->CloseStatus.usStatus & 0xff;
+                if (reason) memcpy( req->control + 2, buffer->CloseStatus.pbReason, reason );
+                req->payload = req->control;
+                req->length = 2 + reason;
+            }
+            break;
+        case WEB_SOCKET_PING_PONG_BUFFER_TYPE:
+            req->opcode = OP_PING;
+            break;
+        case WEB_SOCKET_UNSOLICITED_PONG_BUFFER_TYPE:
+            req->opcode = OP_PONG;
+            break;
+        default:
+            hr = E_INVALIDARG;
+            break;
+        }
+        if (SUCCEEDED(hr)) req->active = TRUE;
+    }
+    LeaveCriticalSection( &ws->cs );
+    return hr;
+}
+
+HRESULT WINAPI WebSocketReceive( WEB_SOCKET_HANDLE handle, WEB_SOCKET_BUFFER *buffer, void *context )
+{
+    struct websocket *ws = get_socket( handle );
+    HRESULT hr = S_OK;
+
+    TRACE( "%p, %p, %p\n", handle, buffer, context );
+
+    if (!ws) return E_INVALIDARG;
+    if (buffer) FIXME( "caller-provided receive buffers are not supported\n" );
+    EnterCriticalSection( &ws->cs );
+    if (ws->aborted) hr = E_INVALID_OPERATION;
+    else
+    {
+        ws->receive_pending = TRUE;
+        ws->receive_app_context = context;
+    }
+    LeaveCriticalSection( &ws->cs );
+    return hr;
+}
