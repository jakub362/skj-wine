+            ws->indicated = 0;
+            buffers[0].Data.pbBuffer = NULL;
+            buffers[0].Data.ulBufferLength = 0;
+            *type = data_type( ws->message_op, TRUE );
+            break;
+        }
+    }
+
+    if (*type != WEB_SOCKET_CLOSE_BUFFER_TYPE)
+        TRACE( "indicating %s\n", debugstr_an( (char *)buffers[0].Data.pbBuffer, min( buffers[0].Data.ulBufferLength, 300 ) ) );
+    *count = 1;
+    *action = WEB_SOCKET_INDICATE_RECEIVE_COMPLETE_ACTION;
+    *action_context = CTX_INDICATE_RECEIVE;
+    ws->receive_outstanding = CTX_INDICATE_RECEIVE;
+    return S_OK;
+
+need_more:
+    if (ws->filled == ws->receive_size)
+    {
+        ERR( "receive buffer full without a complete frame header\n" );
+        return E_INVALID_PROTOCOL_FORMAT;
+    }
+    buffers[0].Data.pbBuffer = data + ws->filled;
+    buffers[0].Data.ulBufferLength = ws->receive_size - ws->filled;
+    *count = 1;
+    *type = WEB_SOCKET_BINARY_FRAGMENT_BUFFER_TYPE;
+    *action = WEB_SOCKET_RECEIVE_FROM_NETWORK_ACTION;
+    *action_context = CTX_RECEIVE_FROM_NETWORK;
+    ws->receive_outstanding = CTX_RECEIVE_FROM_NETWORK;
+    return S_OK;
+}
+
+HRESULT WINAPI WebSocketGetAction( WEB_SOCKET_HANDLE handle, WEB_SOCKET_ACTION_QUEUE queue, WEB_SOCKET_BUFFER *buffers,
+        ULONG *count, WEB_SOCKET_ACTION *action, WEB_SOCKET_BUFFER_TYPE *type, void **app_context, void **action_context )
+{
+    struct websocket *ws = get_socket( handle );
+    void *dummy_app, *dummy_action;
+    HRESULT hr = S_OK;
+    ULONG max;
+
+    TRACE( "%p, %u, %p, %p, %p, %p, %p, %p\n", handle, queue, buffers, count, action, type, app_context, action_context );
+
+    if (!ws || !count || !action || !type) return E_INVALIDARG;
+    if (!app_context) app_context = &dummy_app;
+    if (!action_context) action_context = &dummy_action;
+    max = *count;
+    if (max && !buffers) return E_INVALIDARG;
+    *action = WEB_SOCKET_NO_ACTION;
+    *type = 0;
+    *app_context = NULL;
+    *action_context = NULL;
+    if (max) memset( buffers, 0, max * sizeof(*buffers) );
+    *count = 0;
+
+    EnterCriticalSection( &ws->cs );
+    if (!ws->aborted)
+    {
+        if ((queue & WEB_SOCKET_SEND_ACTION_QUEUE) && !ws->sending && max)
+        {
+            *count = max;
+            get_send_action( ws, buffers, count, action, type, app_context, action_context );
+        }
+        if (*action == WEB_SOCKET_NO_ACTION && (queue & WEB_SOCKET_RECEIVE_ACTION_QUEUE) && !ws->receive_outstanding && max)
+            hr = get_receive_action( ws, buffers, count, action, type, app_context, action_context );
+        if (*action == WEB_SOCKET_NO_ACTION) *count = 0;
+    }
+    LeaveCriticalSection( &ws->cs );
+
+    TRACE( "-> %#lx, action %u, type %#x, count %lu\n", hr, *action, *type, *count );
+    return hr;
+}
+
+VOID WINAPI WebSocketCompleteAction( WEB_SOCKET_HANDLE handle, void *context, ULONG bytes )
+{
+    struct websocket *ws = get_socket( handle );
+    struct send_request *req;
+
+    TRACE( "%p, %p, %lu\n", handle, context, bytes );
+
+    if (!ws) return;
+    EnterCriticalSection( &ws->cs );
+    if (context == CTX_RECEIVE_FROM_NETWORK && ws->receive_outstanding == context)
+    {
+        ws->filled += min( bytes, ws->receive_size - ws->filled );
+        ws->receive_outstanding = NULL;
+    }
+    else if (context == CTX_INDICATE_RECEIVE && ws->receive_outstanding == context)
+    {
+        /* all indicated bytes are the caller's now (.NET keeps what it can't take at once) */
+        drop_received( ws, ws->indicated );
+        ws->indicated = 0;
+        ws->receive_outstanding = NULL;
+        ws->receive_pending = FALSE;
+    }
+    else if (context == CTX_SEND_TO_NETWORK && (req = ws->sending))
+    {
+        req->header_sent = TRUE;
+        req->done += ws->send_chunk;
+        if (req->done >= req->length)
+        {
+            if (req == &ws->pong) req->active = FALSE;  /* nobody waits for this one */
+            else req->complete = TRUE;
+        }
+        ws->sending = NULL;
+    }
+    else if (context == CTX_INDICATE_SEND && (req = ws->sending))
+    {
+        req->active = FALSE;
+        ws->sending = NULL;
+    }
+    else WARN( "unexpected completion %p\n", context );
+    LeaveCriticalSection( &ws->cs );
+}
+
+HRESULT WINAPI WebSocketGetGlobalProperty( WEB_SOCKET_PROPERTY_TYPE type, void *value, ULONG *size )
+{
+    TRACE( "%u, %p, %p\n", type, value, size );
+
+    if (!value || !size || *size < sizeof(ULONG)) return E_INVALIDARG;
+    switch (type)
+    {
+    case WEB_SOCKET_RECEIVE_BUFFER_SIZE_PROPERTY_TYPE:
+    case WEB_SOCKET_SEND_BUFFER_SIZE_PROPERTY_TYPE:
+        *(ULONG *)value = DEFAULT_BUFFER_SIZE;
+        break;
+    case WEB_SOCKET_KEEPALIVE_INTERVAL_PROPERTY_TYPE:
+        *(ULONG *)value = DEFAULT_KEEPALIVE_MS;
+        break;
+    case WEB_SOCKET_SUPPORTED_VERSIONS_PROPERTY_TYPE:
+        *(ULONG *)value = 13;
+        break;
+    default:
+        return E_INVALIDARG;
+    }
+    *size = sizeof(ULONG);
+    return S_OK;
+}
+
+VOID WINAPI WebSocketAbortHandle( WEB_SOCKET_HANDLE handle )
+{
+    struct websocket *ws = get_socket( handle );
+
+    TRACE( "%p\n", handle );
+
+    if (!ws) return;
+    EnterCriticalSection( &ws->cs );
+    ws->aborted = TRUE;
+    LeaveCriticalSection( &ws->cs );
+}
+
+VOID WINAPI WebSocketDeleteHandle( WEB_SOCKET_HANDLE handle )
+{
+    struct websocket *ws = get_socket( handle );
+
+    TRACE( "%p\n", handle );
+
+    if (!ws) return;
+    ws->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection( &ws->cs );
+    free( ws->own_block );
+    free( ws );
 }
